---
import Logo from './Logo.astro';
import { url } from '../lib/url';
import { SITE } from '../data/site';
import { courses } from '../data/courses';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div class="about">
      <Logo />
      <p class="muted">{SITE.tagline}. Курсы проходят на Stepik, разборы и анонсы — в Telegram.</p>
      <p class="slogan mono">{SITE.slogan}</p>
    </div>
    <nav aria-label="Курсы">
      <h2 class="col-title">Курсы</h2>
      <ul>
        {courses.map((c) => <li><a href={url(`/courses/${c.slug}/`)}>{c.shortTitle}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Разделы">
      <h2 class="col-title">Разделы</h2>
      <ul>
        <li><a href={url('/courses/')}>Каталог курсов</a></li>
        <li><a href={url('/paths/')}>Маршруты обучения</a></li>
        <li><a href={url('/opsdeck/')}>OpsDeck</a></li>
        <li><a href={url('/community/')}>Сообщество</a></li>
      </ul>
    </nav>
    <nav aria-label="Ссылки">
      <h2 class="col-title">Ссылки</h2>
      <ul>
        <li><a href={SITE.telegram} target="_blank" rel="noopener" data-track="telegram" data-track-place="footer">Telegram {SITE.telegramHandle}</a></li>
        <li><a href={SITE.opsdeckRepo} target="_blank" rel="noopener">OpsDeck на GitHub</a></li>
        <li><a href="https://stepik.org" target="_blank" rel="noopener">Stepik</a></li>
      </ul>
    </nav>
  </div>
  <div class="container bottom">
    <span>© {year} {SITE.fullName}</span>
    <span class="muted">Цены и программы курсов сверены со Stepik на дату обновления сайта</span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-2); padding-top: 56px; margin-top: auto; }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 32px; padding-bottom: 40px; }
  .about { display: grid; gap: 16px; align-content: start; max-width: 340px; }
  .about p { font-size: 14.5px; }
  .slogan { font-size: 12.5px; letter-spacing: 0.14em; color: var(--teal); }
  .col-title { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 14px; }
  ul { list-style: none; display: grid; gap: 9px; }
  ul a { color: var(--text-2); font-size: 14.5px; }
  ul a:hover { color: var(--text); }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 22px; border-top: 1px solid var(--line); font-size: 13px; color: var(--text-2); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; max-width: none; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
</style>
