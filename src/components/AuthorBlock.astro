---
import Icon from './Icon.astro';
import { AUTHOR } from '../data/author';
import { SITE } from '../data/site';
import { url } from '../lib/url';
interface Props { variant?: 'full' | 'compact' }
const { variant = 'full' } = Astro.props;
const initial = AUTHOR.name.charAt(0);
---
{variant === 'full' ? (
  <div class="author card" id="author">
    <div class="bg-grid"></div>
    <div class="a-grid">
      <div class="a-id">
        {AUTHOR.photo
          ? <img class="avatar" src={url(AUTHOR.photo)} alt={AUTHOR.name} width="120" height="120" loading="lazy" />
          : <span class="avatar mono" aria-hidden="true">{initial}<i></i></span>}
        <div>
          <span class="eyebrow">Автор курсов</span>
          <h2 class="h2 a-name">{AUTHOR.name}</h2>
          <p class="a-role mono">{AUTHOR.role}</p>
        </div>
      </div>
      <div class="a-body">
        <p class="lead">{AUTHOR.lead}</p>
        <ul class="checklist">{AUTHOR.facts.map((f) => <li>{f}</li>)}</ul>
        <div class="a-stack">
          <p class="mono a-k">рабочий стек</p>
          <div class="chips">{AUTHOR.stack.map((s) => <span class="tag tag--mono">{s}</span>)}</div>
        </div>
        <div class="a-links">
          <a class="btn btn--sm" href={SITE.telegram} target="_blank" rel="noopener" data-track="telegram" data-track-place="author"><Icon name="telegram" size={16} /> {SITE.telegramHandle}</a>
          <a class="btn btn--sm btn--ghost" href={AUTHOR.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
        </div>
      </div>
    </div>
  </div>
) : (
  <a class="author-c card card--hover" href={url('/#author')}>
    {AUTHOR.photo
      ? <img class="avatar sm" src={url(AUTHOR.photo)} alt="" width="56" height="56" loading="lazy" />
      : <span class="avatar sm mono" aria-hidden="true">{initial}<i></i></span>}
    <span class="c-txt">
      <span class="c-name">{AUTHOR.name}{' '}<span class="muted">· {AUTHOR.role}</span></span>
      <span class="muted c-short">{AUTHOR.short}</span>
    </span>
    <Icon name="arrow" size={16} class="c-go" />
  </a>
)}
<style>
  .author { overflow: hidden; padding: clamp(24px, 4vw, 48px); scroll-margin-top: 90px; }
  .a-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 0.8fr 1.4fr; gap: clamp(24px, 5vw, 64px); }
  .a-id { display: grid; gap: 20px; align-content: start; }
  .avatar { position: relative; width: 120px; height: 120px; border-radius: 22px; display: grid; place-items: center; font-size: 52px; font-weight: 600; color: var(--teal); background: radial-gradient(80% 80% at 30% 20%, rgb(45 212 191 / 0.18), transparent 70%), var(--surface-2); border: 1px solid rgb(45 212 191 / 0.35); object-fit: cover; }
  .avatar i { position: absolute; right: 22px; bottom: 26px; width: 16px; height: 4px; background: var(--text); border-radius: 2px; }
  .avatar.sm { width: 56px; height: 56px; border-radius: 14px; font-size: 24px; flex: none; }
  .avatar.sm i { right: 10px; bottom: 12px; width: 8px; height: 2.5px; }
  .a-name { margin-top: 10px; }
  .a-role { margin-top: 8px; font-size: 13px; color: var(--muted); }
  .a-body { display: grid; gap: 22px; align-content: start; }
  .a-k { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .a-stack { display: grid; gap: 10px; }
  .a-links { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 860px) { .a-grid { grid-template-columns: 1fr; } .a-id { grid-template-columns: auto 1fr; align-items: center; } .avatar:not(.sm) { width: 88px; height: 88px; font-size: 38px; border-radius: 18px; } .avatar:not(.sm) i { right: 16px; bottom: 19px; width: 12px; height: 3px; } }

  .author-c { display: flex; align-items: center; gap: 16px; padding: 16px 18px; }
  .c-txt { display: grid; gap: 3px; flex: 1; min-width: 0; }
  .c-name { font-weight: 620; }
  .c-short { font-size: 14px; }
  .author-c :global(.c-go) { flex: none; color: var(--muted); }
</style>
