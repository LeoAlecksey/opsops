---
import type { Course } from '../data/types';
import { LEVEL_LABEL, STATUS_LABEL } from '../data/types';
import { url, plural } from '../lib/url';
import { lessonCount } from '../data/courses';
import CourseCover from './CourseCover.astro';
import Icon from './Icon.astro';
interface Props { course: Course; headingLevel?: 'h2' | 'h3' }
const { course: c, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const n = lessonCount(c);
---
<article class="card card--hover course-card"
  data-category={c.category} data-level={c.level} data-status={c.status}
  data-search={[c.title, c.summary, c.category, ...c.technologies].join(' ').toLowerCase()}>
  <a href={url(`/courses/${c.slug}/`)} class="stretched" aria-label={c.title}></a>
  <CourseCover course={c} />
  <div class="body">
    <div class="meta">
      <span class:list={['tag', `tag--${c.status}`]}><span class="dot"></span>{STATUS_LABEL[c.status]}</span>
      <span class="tag">{LEVEL_LABEL[c.level]}</span>
    </div>
    <H class="title">{c.title}</H>
    <p class="summary">{c.headline}</p>
    <div class="foot">
      <span class="facts mono">
        {n > 0 ? <span>{c.modules.length} {plural(c.modules.length, ['модуль','модуля','модулей'])} · {n} {plural(n, ['урок','урока','уроков'])}</span> : <span>программа готовится</span>}
      </span>
      <span class="price">{c.price ?? '—'}</span>
    </div>
  </div>
  <span class="go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
</article>
<style>
  .course-card { display: flex; flex-direction: column; padding: 10px; height: 100%; }
  .stretched { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .body { display: flex; flex-direction: column; gap: 12px; padding: 16px 10px 10px; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .title { font-size: 18.5px; line-height: 1.3; letter-spacing: -0.015em; font-weight: 640; }
  .summary { color: var(--text-2); font-size: 14.5px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--line); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .facts { font-size: 12.5px; color: var(--muted); }
  .price { font-weight: 650; font-size: 15px; }
  .go { position: absolute; top: 22px; right: 22px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: rgb(10 14 19 / 0.7); border: 1px solid var(--line-2); color: var(--text); opacity: 0; transform: translateX(-4px); transition: opacity 0.2s, transform 0.2s; }
  .course-card:hover .go, .course-card:focus-within .go { opacity: 1; transform: none; }
  .course-card:focus-within { border-color: var(--teal); }
</style>
