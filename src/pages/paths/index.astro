---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { paths } from '../../data/paths';
import { getCourse, stepikUrl } from '../../data/courses';
import { LEVEL_LABEL, STATUS_LABEL } from '../../data/types';
import { url } from '../../lib/url';
---
<Base title="Маршруты обучения: техподдержка, инфраструктура, DevOps-эксплуатация"
  description="Рекомендуемый порядок курсов OpsOps Expertise: старт в IT через техподдержку, инфраструктура и автоматизация (Proxmox, Ansible), DevOps-эксплуатация (GitLab CI, K3s, ИИ).">
  <section class="page-head">
    <div class="bg-grid"></div>
    <div class="container head">
      <nav class="crumbs" aria-label="Хлебные крошки"><a href={url('/')}>главная</a><span aria-hidden="true">/</span><span>маршруты</span></nav>
      <h1 class="h1">Маршруты обучения</h1>
      <p class="lead">Маршрут подсказывает, с какого курса начать и в каком порядке двигаться дальше. Он собран только из существующих курсов, поэтому мы не называем его «профессией» — там, где маршрут неполный, это сказано прямо.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container list">
      {paths.map((p, i) => (
        <article class="card path" id={p.slug}>
          <header class="ph">
            <span class="pk mono">route/{String(i + 1).padStart(2, '0')}</span>
            <h2 class="h2">{p.title}</h2>
            <p class="lead">{p.forWhom}</p>
          </header>
          <div class="pg">
            <div class="meta">
              <div><h3 class="mk mono">Стартовый уровень</h3><p>{p.startLevel}</p></div>
              <div><h3 class="mk mono">Что нужно</h3><ul class="dashlist">{p.prerequisites.map((x) => <li>{x}</li>)}</ul></div>
              <div><h3 class="mk mono">Практические навыки</h3><ul class="checklist">{p.skills.map((x) => <li>{x}</li>)}</ul></div>
              <div><h3 class="mk mono">Следующий уровень</h3><p class="muted">{p.next}</p></div>
            </div>
            <ol class="steps">
              {p.steps.map((s, k) => {
                const c = getCourse(s.course)!;
                const st = stepikUrl(c);
                return (
                  <li class:list={['step', c.status]}>
                    <span class="sn mono">{k + 1}</span>
                    <div class="sc">
                      <div class="chips">
                        <span class:list={['tag', `tag--${c.status}`]}><span class="dot"></span>{STATUS_LABEL[c.status]}</span>
                        <span class="tag">{LEVEL_LABEL[c.level]}</span>
                        {c.price && <span class="tag">{c.price}</span>}
                      </div>
                      <h3 class="h3"><a href={url(`/courses/${c.slug}/`)}>{c.title}</a></h3>
                      <p class="muted">{s.why}</p>
                      <div class="sa">
                        <a class="btn btn--sm" href={url(`/courses/${c.slug}/`)}>О курсе</a>
                        {st && <a class="btn btn--sm btn--ghost" href={st} target="_blank" rel="noopener" data-track="stepik" data-track-course={c.slug} data-track-place="paths">Stepik <Icon name="external" size={15} /></a>}
                      </div>
                    </div>
                  </li>
                );
              })}
            </ol>
          </div>
          {p.note && <p class="pnote"><Icon name="flag" size={16} /> {p.note}</p>}
        </article>
      ))}
    </div>
  </section>
</Base>
<style>
  .page-head { position: relative; padding-block: clamp(48px, 7vw, 88px) 12px; overflow: hidden; }
  .head { position: relative; z-index: 1; display: grid; gap: 18px; }
  .head .lead { max-width: 820px; }
  .list { display: grid; gap: 24px; }
  .path { padding: clamp(22px, 3.4vw, 40px); display: grid; gap: 28px; scroll-margin-top: 90px; }
  .ph { display: grid; gap: 12px; max-width: 820px; }
  .pk { font-size: 12px; color: var(--teal); letter-spacing: 0.06em; }
  .pg { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(24px, 4vw, 48px); }
  .meta { display: grid; gap: 22px; align-content: start; }
  .mk { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 8px; }
  .steps { list-style: none; display: grid; gap: 12px; position: relative; }
  .step { display: grid; grid-template-columns: 36px 1fr; gap: 14px; }
  .sn { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgb(45 212 191 / 0.4); color: var(--teal); background: var(--teal-dim); font-size: 14px; }
  .step.soon .sn { border-color: rgb(242 180 90 / 0.4); color: var(--amber); background: var(--amber-dim); }
  .sc { display: grid; gap: 10px; padding: 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); }
  .sc h3 a:hover { color: var(--teal); }
  .sa { display: flex; gap: 8px; flex-wrap: wrap; }
  .pnote { display: flex; gap: 10px; align-items: flex-start; padding: 14px 16px; border-radius: 10px; background: var(--amber-dim); color: #f6d5a3; font-size: 14.5px; border: 1px solid rgb(242 180 90 / 0.2); }
  .pnote :global(svg) { flex: none; margin-top: 3px; }
  @media (max-width: 900px) { .pg { grid-template-columns: 1fr; } .steps { order: -1; } }
</style>
