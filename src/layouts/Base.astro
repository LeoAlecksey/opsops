---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** путь к OG-картинке относительно корня сайта, например /og/default.png */
  image?: string;
  keywords?: string[];
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image = '/og/default.png', keywords, type = 'website', jsonLd, noindex = false } = Astro.props;

const fullTitle = title.includes('OpsOps') ? title : `${title} — OpsOps Expertise`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
const metrikaId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID as string | undefined;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0e13" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/site';
    </script>

    {metrikaId && (
      <script is:inline define:vars={{ metrikaId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        window.ym(Number(metrikaId), "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true });
        window.__ymId = Number(metrikaId);
      </script>
    )}
  </body>
</html>

<style is:global>
  body { min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; }
</style>
